# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection. The default matches docker-compose.yml.
DATABASE_URL=postgresql://kayan:kayan@127.0.0.1:5433/kayan

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# The address people type in the browser, with no trailing slash.
# Used for links inside emails and to reject requests from other sites.
# Open the site with exactly this address: localhost and 127.0.0.1 count as different sites.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP. The defaults point at Mailpit from docker-compose.yml (inbox: http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@kayan.test
# The sender name people see. Usually the academy's name.
EMAIL_FROM_NAME=Helal Academy

# Optional. Where uploaded files are kept on disk. Leave empty to use the project folder.
UPLOADS_DIR=

# The academy's name, as people see it in the header, page titles, and emails. The project itself
# is called kayan; each academy that runs it sets its own name here. Defaults to "Kayan".
SITE_NAME_AR=هلال أكاديمي
SITE_NAME_EN=Helal Academy

# The doctor the academy is built around, named on the home page ("Learn ... with Dr. Hassan Helal").
# Defaults to the academy name.
INSTRUCTOR_NAME_AR=د. حسن هلال
INSTRUCTOR_NAME_EN=Dr. Hassan Helal

# The doctor's photo on the home page: a file you put in /public. Optional; without it the home page
# shows an illustration. And a short line under the name.
INSTRUCTOR_PHOTO=/academy/hassan-helal-portrait.webp
INSTRUCTOR_TITLE_AR=طبيب بيطري استشاري في الدواجن والحيوانات الأليفة والحيوانات المزرعية والتحاليل والسونار والجراحة
INSTRUCTOR_TITLE_EN=Consultant veterinarian in poultry, pets and farm animals, lab tests, ultrasound and surgery
